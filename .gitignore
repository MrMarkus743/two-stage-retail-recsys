# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing & Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Big Data & Storage Isolation (Repo-Guard)
# Блокировка сырых и промежуточных данных
data/raw/
data/processed/
*.csv
*.parquet
*.npz
*.tar.gz
*.zip

# Белый список для легких тестовых фикстур и структуры
!data/.gitkeep
!data/sample/
!data/sample/**
!data/sample/.gitkeep